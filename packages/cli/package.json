    "bin": {
      "linkly": "./dist/bin/linkly.mjs"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@linkly/core": "workspace:*",
    "@stricli/core": "catalog:",
    "picocolors": "catalog:"
